# Copy this file to `.env.local` and paste your keys.
# Get a Gemini key: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional Gemini controls (chat answers only)
GEMINI_MODEL=gemini-3.6-flash
# UI answer-model picker defaults to GEMINI_MODEL; change in the chat header anytime.
# New AI Studio keys: use gemini-3.6-flash or gemini-3.5-flash-lite (2.5 is often blocked).
MAX_OUTPUT_TOKENS=1024
DAILY_TOKEN_BUDGET=100000
MAX_HISTORY_MESSAGES=20

# Local MiniLM embeddings (no Gemini embedding quota)
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Pinecone (RAG) — Dense cosine index with dimension 384 for MiniLM
PINECONE_API_KEY=
PINECONE_INDEX=minilm
# Optional: full host from Pinecone index page (without https://)
# PINECONE_HOST=

# RAG tuneables / scoring
RAG_TOP_K=8
RAG_ANSWER_COUNT=3
# Drop Pinecone hits below this cosine similarity (0–1)
RAG_MIN_SCORE=0.2
# Extra score when sector / BHK matches the question
RAG_SECTOR_BOOST=0.2
RAG_BEDROOM_BOOST=0.05
# How many candidates to pull when filters are present
RAG_FILTER_TOP_K=120
EMBED_BATCH_SIZE=32
LISTINGS_CSV_PATH=data/clean_dataset.csv

# PageIndex (Vectorless docs) — Gemini for index + chat
PAGEINDEX_LLM=gemini
PAGEINDEX_CHAT_PROVIDER=gemini
# Defaults to GEMINI_MODEL when unset; override if needed:
# PAGEINDEX_INDEX_MODEL=gemini/gemini-3.6-flash
# PAGEINDEX_CHAT_MODEL=gemini/gemini-3.6-flash
# PAGEINDEX_GEMINI_MODEL=gemini-3.6-flash

# Optional: local Ollama instead (avoids Gemini quota)
# PAGEINDEX_LLM=ollama
# PAGEINDEX_CHAT_PROVIDER=ollama
# PAGEINDEX_OLLAMA_MODEL=ollama/llama3.2:3b
# PAGEINDEX_INDEX_MODEL=ollama/llama3.2:3b
# PAGEINDEX_CHAT_MODEL=ollama/llama3.2:3b
OLLAMA_API_BASE=http://127.0.0.1:11434
# UI model picker includes "Ollama (llama3.2:3b)" — keep this model pulled: ollama pull llama3.2:3b

# Groq — optional cloud fallback
GROQ_API_KEY=
PAGEINDEX_GROQ_MODEL=groq/openai/gpt-oss-20b

# Retrieval mode default is chosen in the UI (Vector RAG | Vectorless | Pandas).
# Vectorless = PageIndex-style tree reasoning over CSV (no Pinecone).
# Optional: run Python service from `vecrtorless rag` on port 8765.
# VECTORLESS_SERVICE_URL=http://127.0.0.1:8765

# LangPanda = Pandas code-execution agent (exact filters / counts / aggregates)
# Start with: npm run langpanda:service
LANGPANDA_SERVICE_URL=http://127.0.0.1:8770
# Pandas + LLM uses the UI model picker (Gemini or Ollama).
# Fallback when no model is passed:
LANGPANDA_OLLAMA_MODEL=llama3.2:3b
# LANGPANDA_GEMINI_MODEL=gemini-3.6-flash
# OLLAMA_API_BASE=http://127.0.0.1:11434
# When Pandas + LLM finds 0 CSV matches (or asks metro/circle-rate/RERA/etc.),
# automatically fall back to free DuckDuckGo search (ddgs — no API key).
LANGPANDA_WEB_FALLBACK=1
