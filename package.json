{
  "name": "dbg-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "index-listings": "tsx scripts/index-listings.ts",
    "patch-listing-metadata": "tsx scripts/patch-listing-metadata.ts",
    "vectorless:demo-pdf": "cd \"vecrtorless rag\" && .venv/bin/python scripts/build_listings_pdf.py",
    "vectorless:index": "cd \"vecrtorless rag\" && .venv/bin/python scripts/index_document.py",
    "vectorless:service": "cd \"vecrtorless rag\" && .venv/bin/python -m uvicorn service.app:app --reload --port 8765",
    "langpanda:service": "cd langpanda && .venv/bin/python -m uvicorn service.app:app --reload --host 127.0.0.1 --port 8770",
    "langpanda:ask": "cd langpanda && .venv/bin/python agent.py"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^8.2.0",
    "@xenova/transformers": "^2.17.2",
    "csv-parse": "^7.0.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
